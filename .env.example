# ==============================================================================
# HARSH SINGH — DATA SCIENCE & ML PORTFOLIO ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to `.env.local` for local overrides or configure in Vercel.
# Note: The portfolio works out of the box WITHOUT any secrets using GitHub's
# public REST API and verified fallback caching.

# 1. Public Site URL (used for SEO canonical links, OpenGraph, and sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://harshsingh-portfolio.vercel.app

# 2. GitHub Username (defaults to harshsingh134 in src/config/siteConfig.ts)
NEXT_PUBLIC_GITHUB_USERNAME=harshsingh134

# 3. Optional GitHub Personal Access Token (Server-side only — NEVER prefix with NEXT_PUBLIC_)
# Increases GitHub API rate limit from 60 req/hr to 5,000 req/hr.
# Leave blank if using standard public API access with 15-minute server caching.
GITHUB_TOKEN=

# 4. Optional Contact Form Webhook URL (Server-side only)
# Connect Formspree, Make, Discord/Slack webhook, or custom endpoint for automated email delivery.
CONTACT_WEBHOOK_URL=
